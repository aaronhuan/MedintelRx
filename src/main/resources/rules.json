      "avoidTargetKey": "tramadol",
      "severity": "MAJOR",
      "windowStartHours": 0,
      "windowEndHours": 120,
      "explanation": "Both increase serotonergic activity, raising serotonin syndrome risk.",
      "recommendedAction": "Avoid or monitor closely."
    },
    {
      "ruleId": "R-004",
      "triggerType": "INGREDIENT",
      "triggerKey": "simvastatin",
      "avoidType": "MEDICATION",
      "avoidTargetKey": "clarithromycin",
      "severity": "CONTRAINDICATED",
      "windowStartHours": 0,
      "windowEndHours": 240,
      "explanation": "Clarithromycin inhibits CYP3A4, increasing simvastatin levels and myopathy risk.",
